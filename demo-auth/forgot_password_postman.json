{
    "info": {
        "_postman_id": "8b5a7a9a-2b1d-4f3b-8e1c-7f5a9e1d8b1c",
        "name": "Studydocs Forgot Password Test",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Request OTP",
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"email\": \"user@example.com\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{baseUrl}}/api/v1/auth/forgot-password/request",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "auth",
                        "forgot-password",
                        "request"
                    ]
                },
                "description": "Gửi yêu cầu nhận mã OTP qua email để khôi phục mật khẩu."
            },
            "response": []
        },
        {
            "name": "2. Get OTP (Internal - for testing)",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/v1/internal/auth/get-otp?email=user@example.com",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "internal",
                        "auth",
                        "get-otp"
                    ],
                    "query": [
                        {
                            "key": "email",
                            "value": "user@example.com"
                        }
                    ]
                },
                "description": "API nội bộ để lấy mã OTP mà không cần check mail (chỉ dùng để test)."
            },
            "response": []
        },
        {
            "name": "3. Confirm Forgot Password",
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"email\": \"user@example.com\",\n    \"otp\": \"123456\",\n    \"newPassword\": \"NewSecurePassword123\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{baseUrl}}/api/v1/auth/forgot-password/confirm",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "auth",
                        "forgot-password",
                        "confirm"
                    ]
                },
                "description": "Xác nhận mã OTP và đặt lại mật khẩu mới."
            },
            "response": []
        }
    ],
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    ""
                ]
            }
        },
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    ""
                ]
            }
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080",
            "type": "string"
        }
    ]
}