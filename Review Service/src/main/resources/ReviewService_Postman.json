{
    "info": {
        "_postman_id": "review-service-id",
        "name": "Review Service API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Reviews (Public/User)",
            "item": [
                {
                    "name": "Get All Reviews",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "http://localhost:8086/api/v1/reviews?page=0&size=10"
                    },
                    "response": []
                },
                {
                    "name": "Create Review",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"documentId\": \"<UUID>\",\n  \"comment\": \"Great document!\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "http://localhost:8086/api/v1/reviews"
                    },
                    "response": []
                },
                {
                    "name": "Get By ID",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "http://localhost:8086/api/v1/reviews/:id",
                        "variable": [
                            {
                                "key": "id",
                                "value": ""
                            }
                        ]
                    },
                    "response": []
                },
                {
                    "name": "Get By Document",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "http://localhost:8086/api/v1/reviews/document/:docId?page=0&size=10",
                        "variable": [
                            {
                                "key": "docId",
                                "value": ""
                            }
                        ]
                    },
                    "response": []
                },
                {
                    "name": "Get By User",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "http://localhost:8086/api/v1/reviews/user/:userId?page=0&size=10",
                        "variable": [
                            {
                                "key": "userId",
                                "value": ""
                            }
                        ]
                    },
                    "response": []
                },
                {
                    "name": "Count By User",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "http://localhost:8086/api/v1/reviews/user/:userId/count",
                        "variable": [
                            {
                                "key": "userId",
                                "value": ""
                            }
                        ]
                    },
                    "response": []
                },
                {
                    "name": "Update Review",
                    "request": {
                        "method": "PUT",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"comment\": \"Updated comment\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "http://localhost:8086/api/v1/reviews/:id",
                        "variable": [
                            {
                                "key": "id",
                                "value": ""
                            }
                        ]
                    },
                    "response": []
                },
                {
                    "name": "Delete Review",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": "http://localhost:8086/api/v1/reviews/:id",
                        "variable": [
                            {
                                "key": "id",
                                "value": ""
                            }
                        ]
                    },
                    "response": []
                },
                {
                    "name": "React to Review",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": "http://localhost:8086/api/v1/reviews/:id/react?type=like",
                        "variable": [
                            {
                                "key": "id",
                                "value": ""
                            }
                        ]
                    },
                    "response": []
                },
                {
                    "name": "React to Document",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": "http://localhost:8086/api/v1/reviews/document/:docId/react?type=like",
                        "variable": [
                            {
                                "key": "docId",
                                "value": ""
                            }
                        ]
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Internal",
            "item": [
                {
                    "name": "Get Top Liked",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "http://localhost:8086/api/v1/internal/reactions/top-liked?limit=10"
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Admin",
            "item": [
                {
                    "name": "Toggle Hidden",
                    "request": {
                        "method": "PUT",
                        "header": [],
                        "url": "http://localhost:8086/api/v1/reviews/:id/hidden?hidden=true",
                        "variable": [
                            {
                                "key": "id",
                                "value": ""
                            }
                        ]
                    },
                    "response": []
                },
                {
                    "name": "Total Reviews",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "http://localhost:8086/api/v1/reviews/admin/stats/reviews/total"
                    },
                    "response": []
                }
            ]
        }
    ]
}