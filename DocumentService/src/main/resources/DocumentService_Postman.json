	},
	"item": [
		{
			"name": "Public",
			"item": [
				{
					"name": "Get All Documents",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:8085/api/v1/documents/public?page=0&size=10",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8085",
							"path": ["api", "v1", "documents", "public"],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "10" }
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Newest Documents",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost:8085/api/v1/documents/public/newest?limit=10"
					},
					"response": []
				},
				{
					"name": "Get Most Liked Documents",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost:8085/api/v1/documents/public/most-liked?limit=10"
					},
					"response": []
				},
				{
					"name": "Get Document By ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost:8085/api/v1/documents/public/:id",
						"variable": [{ "key": "id", "value": "" }]
					},
					"response": []
				},
				{
					"name": "Check Exists",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost:8085/api/v1/documents/public/:id/exists",
						"variable": [{ "key": "id", "value": "" }]
					},
					"response": []
				}
			]
		},
		{
			"name": "User",
			"item": [
				{
					"name": "Upload Document",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "data",
									"value": "{\"title\":\"Doc Title\", \"description\": \"Doc Desc\", \"schoolYear\": \"2025-2026\"}",
									"type": "text",
									"contentType": "application/json"
								},
								{ "key": "file", "type": "file", "src": [] }
							]
						},
						"url": "http://localhost:8085/api/v1/documents/user"
					},
					"response": []
				},
				{
					"name": "Update Document",
					"request": {
						"method": "PUT",
						"header": [],
						"url": "http://localhost:8085/api/v1/documents/user/:id?title=New Title&description=New Desc",
						"variable": [{ "key": "id", "value": "" }]
					},
					"response": []
				},
				{
					"name": "Delete Document",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": "http://localhost:8085/api/v1/documents/user/:id",
						"variable": [{ "key": "id", "value": "" }]
					},
					"response": []
				},
				{
					"name": "Get My Documents",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost:8085/api/v1/documents/user/me?page=0&size=10"
					},
					"response": []
				},
				{
					"name": "Get My Newest",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost:8085/api/v1/documents/user/me/newest?limit=10"
					},
					"response": []
				},
				{
					"name": "Get View History",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost:8085/api/v1/documents/user/me/history?page=0&size=10"
					},
					"response": []
				}
			],
			"auth": {
				"type": "bearer",
				"bearer": [
					{ "key": "token", "value": "", "type": "string" }
				]
			}
		},
		{
			"name": "Admin",
			"item": [
				{
					"name": "Total Documents",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost:8085/api/v1/documents/admin/stats/total"
					},
					"response": []
