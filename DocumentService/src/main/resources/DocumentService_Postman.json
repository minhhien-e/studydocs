					"name": "System Stats",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost:8085/api/v1/documents/admin/stats/system?period=day"
					},
					"response": []
				}
			],
			"auth": {
				"type": "bearer",
				"bearer": [
					{ "key": "token", "value": "", "type": "string" }
